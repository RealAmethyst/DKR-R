include("${CMAKE_CURRENT_LIST_DIR}/../online-performance/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_character_portraits)
  set(auth "${DKRPORT_ROOT}/patches/character-library-portraits")
  set(stage "${CMAKE_BINARY_DIR}/generated/character-library-portraits")
  file(MAKE_DIRECTORY "${stage}")
  get_target_property(sources DKRPortGame SOURCES)
  list(FILTER sources INCLUDE REGEX "[/\\]runtime_ui.cpp$")
  list(LENGTH sources count)
  if(NOT count EQUAL 1)
   message(FATAL_ERROR "Character portraits need one final launcher source")
  endif()
  list(GET sources 0 old)
  file(TO_CMAKE_PATH "${old}" old)
  get_target_property(account_sources DKRPortGame SOURCES)
  list(FILTER account_sources INCLUDE REGEX "[/\\]mod_store.cpp$")
  list(LENGTH account_sources account_count)
  if(NOT account_count EQUAL 1)
   message(FATAL_ERROR "Online profile needs one account service source")
  endif()
  list(GET account_sources 0 account_old)
  file(TO_CMAKE_PATH "${account_old}" account_old)
  file(WRITE "${stage}/inputs.json" "[{\"target\":\"DKRPortGame\",\"path\":\"${old}\"},{\"target\":\"DKRPortGame\",\"path\":\"${CMAKE_BINARY_DIR}/generated/custom-vehicles/native/runtime_mod_library_ui.inl\"},{\"target\":\"DKRPortGame\",\"path\":\"${account_old}\"}]")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*" "${auth}/tests/*")
  file(GLOB profile_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/online_profile/*")
  list(APPEND authored ${profile_authored})
  list(APPEND authored "${DKRPORT_ROOT}/runtime-recomp/src/game/mod_store/download_history.hpp")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Character portraits staging failed")
  endif()
  set(next "${stage}/runtime_ui.cpp")
  get_target_property(directory DKRPortGame SOURCE_DIR)
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior "${old}" DIRECTORY)
  get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
  set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
  dkr_repair_replace_source(DKRPortGame "${old}" "${next}")
  set(next "${stage}/mod_store.cpp")
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${account_old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${account_old}" DIRECTORY "${directory}" PROPERTY ${property})
    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior "${account_old}" DIRECTORY)
  get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
  set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
  dkr_repair_replace_source(DKRPortGame "${account_old}" "${next}")
  get_target_property(friend_sources DKRNetplayCore SOURCES)
  list(FILTER friend_sources INCLUDE REGEX "[/\\]friend_service.cpp$")
  list(LENGTH friend_sources friend_count)
  if(NOT friend_count EQUAL 1)
   message(FATAL_ERROR "Social profiles need one retained friend service")
  endif()
  list(GET friend_sources 0 friend_old)
  dkr_repair_replace_source(DKRNetplayCore "${friend_old}" "${DKRPORT_ROOT}/runtime-recomp/src/game/online_profile/friend_service.cpp")
  add_library(DKRCharacterPortraits STATIC "${stage}/character_portraits.cpp")
  target_compile_features(DKRCharacterPortraits PRIVATE cxx_std_20)
  target_compile_definitions(DKRCharacterPortraits PRIVATE NOMINMAX)
  target_include_directories(DKRCharacterPortraits PUBLIC "${stage}" PRIVATE "${DKRPORT_ROOT}/patches/texture-dumping/native")
  target_link_libraries(DKRCharacterPortraits PUBLIC DKRLegacyModCore)
  target_link_libraries(DKRPortGame PRIVATE DKRCharacterPortraits)
  add_executable(DKRCharacterPortraitChecks EXCLUDE_FROM_ALL "${auth}/tests/portrait_checks.cpp")
  target_compile_features(DKRCharacterPortraitChecks PRIVATE cxx_std_20)
  target_compile_definitions(DKRCharacterPortraitChecks PRIVATE NOMINMAX)
  target_link_libraries(DKRCharacterPortraitChecks PRIVATE DKRCharacterPortraits)
  add_executable(DKRProfileChecks EXCLUDE_FROM_ALL "${DKRPORT_ROOT}/runtime-recomp/tests/online_profile_tests.cpp")
  target_compile_features(DKRProfileChecks PRIVATE cxx_std_20)
  target_include_directories(DKRProfileChecks PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game")
  add_executable(DKRModStoreHistoryChecks EXCLUDE_FROM_ALL "${DKRPORT_ROOT}/runtime-recomp/tests/mod_store_history_tests.cpp")
  target_compile_features(DKRModStoreHistoryChecks PRIVATE cxx_std_20)
  target_include_directories(DKRModStoreHistoryChecks PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game"
      "${DKRPORT_ROOT}/extern/rt64/src/contrib")
  get_target_property(links DKRPortGame LINK_DIRECTORIES)
  if(links)
   target_link_directories(DKRCharacterPortraitChecks PRIVATE ${links})
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_character_portraits)
endif()
